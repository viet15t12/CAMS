# Auto detect text files and perform LF normalization
* text=auto

# The main-provided report PDF is binary even when its first bytes look textual.
/00_report/main.pdf binary

# Documentation images preserve exact repository bytes on every platform.
# Application/runtime assets retain the default text policy.
/00_book/figures/**/*.svg -text
/00_book/figures/**/*.png -text
/00_book/figures/**/*.jpg -text
/00_book/figures/**/*.jpeg -text
/00_book/figures/**/*.webp -text
/00_book/figures/**/*.gif -text
/00_report/**/*.svg -text
/00_report/**/*.png -text
/00_report/**/*.jpg -text
/00_report/**/*.jpeg -text
/00_report/**/*.webp -text
/00_report/**/*.gif -text
/documentation_assets/**/*.svg -text
/documentation_assets/**/*.png -text
/documentation_assets/**/*.jpg -text
/documentation_assets/**/*.jpeg -text
/documentation_assets/**/*.webp -text
/documentation_assets/**/*.gif -text
