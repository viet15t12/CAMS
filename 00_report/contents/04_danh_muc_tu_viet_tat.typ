  table.header(
    [*Từ viết tắt*], [*Tên đầy đủ*], [*Ý nghĩa*]
  ),
  [ABR], [Area Border Router], [Router biên giữa các vùng trong OSPF],
  [ACL], [Access Control List], [Danh sách kiểm soát truy cập],
  [AES], [Advanced Encryption Standard], [Tiêu chuẩn mã hóa nâng cao],
  [API], [Application Programming Interface], [Giao diện lập trình ứng dụng],
  [ARP], [Address Resolution Protocol], [Giao thức phân giải địa chỉ IPv4 sang địa chỉ MAC],
  [AS], [Autonomous System], [Hệ thống tự trị trong định tuyến],
  [ASBR], [Autonomous System Boundary Router], [Router biên hệ tự trị trong OSPF],
  [BGP], [Border Gateway Protocol], [Giao thức định tuyến liên miền],
  [CLI], [Command-Line Interface], [Giao diện dòng lệnh],
